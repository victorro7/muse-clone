# Server env — copy to .env (never commit it).
# This is the hosted brain. The phone app points at it via EXPO_PUBLIC_API_URL.

# --- Supabase (persistence + vector memory). Optional: without these the
# --- server runs memoryless, exactly like the local dev route.
# Create a project at https://supabase.com/dashboard, run supabase/schema.sql
# in the SQL editor, then copy these from Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Composio (tool calling — required)
# Get COMPOSIO_API_KEY from https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# --- LLM for the brain (required). Pick ONE:
# - Gemini free tier (no credit card): get GEMINI_API_KEY from https://aistudio.google.com/apikey
# - OpenAI (paid, ~pennies/month): get OPENAI_API_KEY from https://platform.openai.com/api-keys
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Model for the agent loop.
# Gemini default: gemini-2.5-flash (free tier). OpenAI default: gpt-4o-mini.
# LLM_MODEL=

# Optional: override the chat-completions endpoint (Gemini's OpenAI-compatible
# endpoint is used automatically when GEMINI_API_KEY is set).
# LLM_BASE_URL=

# Optional: comma-separated Composio toolkit slugs, e.g. gmail,googlecalendar,slack
# Leave empty to use every toolkit connected in your Composio dashboard.
COMPOSIO_TOOLKITS=

# Single-user id for Phase 1. Stored as users.id in Supabase.
# When you add real auth later, replace this with the authenticated user id.
SINGLE_USER_ID=muse-clone-user

# Port the server listens on (Render sets PORT automatically).
PORT=3001
