# Keys for the app's brain (the /api/chat route). Never commit this file.
# Get COMPOSIO_API_KEY from https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=
# LLM for the brain. Pick ONE:
# - Gemini free tier (no credit card): get GEMINI_API_KEY from https://aistudio.google.com/apikey
# - OpenAI (paid, ~pennies/month): get OPENAI_API_KEY from https://platform.openai.com/api-keys
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Model for the agent.
# Gemini default: gemini-2.5-flash (free tier). OpenAI default: gpt-4o-mini.
# LLM_MODEL=
# Optional: override the chat-completions endpoint (Gemini's OpenAI-compatible
# endpoint is used automatically when GEMINI_API_KEY is set).
# LLM_BASE_URL=
# Optional: comma-separated Composio toolkit slugs to enable, e.g. gmail,googlecalendar,slack
# Leave empty to use every toolkit connected in your Composio dashboard.
COMPOSIO_TOOLKITS=

# Optional: point the app at the HOSTED brain instead of the dev server route.
# Deploy the server (see server/README.md), then set this to its public URL,
# e.g. EXPO_PUBLIC_API_URL=https://muse-clone-server.onrender.com
# Server-side keys live in server/.env (see server/.env.example) — not here.
# Note: public env vars are inlined at bundle time, so restart the dev server
# after changing this.
# EXPO_PUBLIC_API_URL=
